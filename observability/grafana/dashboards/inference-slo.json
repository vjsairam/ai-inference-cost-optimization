        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(gateway_request_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(gateway_request_latency_seconds_bucket[5m])))", "legendFormat": "p99 {{provider}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Time to first token p50/p95/p99",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(gateway_ttft_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(gateway_ttft_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(gateway_ttft_seconds_bucket[5m])))", "legendFormat": "p99 {{provider}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 9},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (provider) (rate(gateway_requests_total[5m]))", "legendFormat": "{{provider}}"}]
    },
    {
      "type": "timeseries",
      "title": "Errors by class",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 9},
      "targets": [{"refId": "A", "expr": "sum by (provider, error_class) (rate(gateway_provider_errors_total[5m]))", "legendFormat": "{{provider}} {{error_class}}"}]
